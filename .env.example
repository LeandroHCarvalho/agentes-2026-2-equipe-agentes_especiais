# =====================================================================
# MODELO DE CONFIGURAÇÃO
#
# 1. Copie este arquivo para um novo arquivo chamado  .env
# 2. Preencha com a SUA chave
# 3. Nunca compartilhe o .env, nunca o envie ao GitHub
#    (o .gitignore já impede isso — não altere aquela linha)
# =====================================================================

# --- Provedor em uso -------------------------------------------------
# Troque estas três linhas para mudar de provedor. O código não muda.

# Opção A — Google Gemini (padrão da disciplina)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=<!-- VERIFICAR: fixar o identificador do modelo do free tier após checar o AI Studio -->
LLM_API_KEY=cole-sua-chave-do-google-ai-studio-aqui

# Opção B — Groq (para loops de agente com muitas iterações)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-8b-instant
# LLM_API_KEY=cole-sua-chave-do-groq-aqui

# Opção C — Ollama local (dado sigiloso; nada sai da sua máquina)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3
# LLM_API_KEY=ollama

# --- Limites de segurança do agente ---------------------------------
# Impedem que um loop mal comportado consuma sua cota do dia.
AGENTE_MAX_ITERACOES=8
AGENTE_MAX_TENTATIVAS_429=5
